<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard hero: either a project with its progress ring, or the next step when there is nothing yet. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hero"
    android:elevation="6dp"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/heroProject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/heroStatus"
                    style="@style/Widget.GradTrack.GlassPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textAppearance="@style/TextAppearance.GradTrack.HeroTitle" />

                <TextView
                    android:id="@+id/heroMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.GradTrack.HeroCaption" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginStart="16dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/heroRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:indicatorColor="@color/white"
                    app:indicatorInset="0dp"
                    app:indicatorSize="88dp"
                    app:trackColor="#33FFFFFF"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/heroPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/white"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/complete"
                        android:textColor="@color/nav_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heroMilestones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.GradTrack.HeroCaption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/heroAction"
                style="@style/Widget.GradTrack.Button.OnHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/heroEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/heroEmptyIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_card"
            android:importantForAccessibility="no"
            android:padding="12dp"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/heroEmptyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textAppearance="@style/TextAppearance.GradTrack.HeroTitle" />

        <TextView
            android:id="@+id/heroEmptyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="@style/TextAppearance.GradTrack.HeroCaption"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/heroEmptyAction"
            style="@style/Widget.GradTrack.Button.OnHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="end" />
    </LinearLayout>
</FrameLayout>
