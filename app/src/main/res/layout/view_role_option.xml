<?xml version="1.0" encoding="utf-8"?>
<!-- "Or continue as" button: switches the login form to another role (Figma 01, Team Leader / Supervisor cards). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/roleIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="8dp"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/roleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.GradTrack.Title" />

        <TextView
            android:id="@+id/roleAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="@string/sign_in"
            android:textAppearance="@style/TextAppearance.GradTrack.Label"
            android:textColor="@color/primary"
            app:drawableEndCompat="@drawable/ic_chevron_right"
            app:drawableTint="@color/primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
