<?xml version="1.0" encoding="utf-8"?>
<!-- Dark green hero card: diagonal gradient with two soft translucent orbs for depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/hero_end"
                android:startColor="@color/hero_start" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="top|end"
        android:right="-60dp"
        android:top="-70dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:bottom="-50dp"
        android:gravity="bottom|end"
        android:right="70dp">
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF" />
        </shape>
    </item>
</layer-list>
