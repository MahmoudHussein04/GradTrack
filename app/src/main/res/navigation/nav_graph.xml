<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Sign out / session expired: clear everything and show login. -->
    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.gradtrack.app.ui.login.LoginFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_login" />

    <!-- Student / Team Leader -->
    <fragment
        android:id="@+id/studentDashboardFragment"
        android:name="com.gradtrack.app.ui.dashboard.StudentDashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_student_dashboard" />
    <fragment
        android:id="@+id/projectDetailsFragment"
        android:name="com.gradtrack.app.ui.project.ProjectDetailsFragment"
        android:label="@string/title_project"
        tools:layout="@layout/fragment_project_details" />
    <fragment
        android:id="@+id/registerProjectFragment"
        android:name="com.gradtrack.app.ui.project.RegisterProjectFragment"
        android:label="@string/title_register_project"
        tools:layout="@layout/fragment_register_project" />
    <fragment
        android:id="@+id/proposalStatusFragment"
        android:name="com.gradtrack.app.ui.project.ProposalStatusFragment"
        android:label="@string/title_proposal_status"
        tools:layout="@layout/fragment_proposal_status" />
    <fragment
        android:id="@+id/teamFragment"
        android:name="com.gradtrack.app.ui.team.TeamFragment"
        android:label="@string/title_team"
        tools:layout="@layout/fragment_team" />
    <fragment
        android:id="@+id/milestonesFragment"
        android:name="com.gradtrack.app.ui.milestones.MilestonesFragment"
        android:label="@string/title_milestones"
        tools:layout="@layout/fragment_milestones" />
    <fragment
        android:id="@+id/tasksFragment"
        android:name="com.gradtrack.app.ui.tasks.TasksFragment"
        android:label="@string/title_tasks"
        tools:layout="@layout/fragment_tasks" />

    <!-- Shared -->
    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.gradtrack.app.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.gradtrack.app.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Supervisor -->
    <fragment
        android:id="@+id/supervisorDashboardFragment"
        android:name="com.gradtrack.app.ui.dashboard.SupervisorDashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_supervisor_dashboard" />
    <fragment
        android:id="@+id/proposalListFragment"
        android:name="com.gradtrack.app.ui.review.ProposalListFragment"
        android:label="@string/title_proposal_reviews"
        tools:layout="@layout/fragment_proposal_list" />
    <fragment
        android:id="@+id/proposalReviewFragment"
        android:name="com.gradtrack.app.ui.review.ProposalReviewFragment"
        android:label="@string/title_proposal_review"
        tools:layout="@layout/fragment_proposal_review">
        <argument
            android:name="proposalId"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/submissionReviewFragment"
        android:name="com.gradtrack.app.ui.review.SubmissionReviewFragment"
        android:label="@string/title_submission_reviews"
        tools:layout="@layout/fragment_submission_review" />
</navigation>
